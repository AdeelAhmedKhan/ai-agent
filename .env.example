NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Supabase (service role — server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM — OpenAI-compatible (groq | dashscope / Qwen)
# Groq free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, etc.
# Dashscope Qwen: qwen-plus, qwen-turbo, qwen2.5-72b-instruct, etc.
LLM_PROVIDER=groq
LLM_API_KEY=your-llm-api-key
# Optional override; defaults set per provider
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=llama-3.3-70b-versatile

# Vapi
VAPI_WEBHOOK_SECRET=your-vapi-webhook-secret
# Used by API + Cursor MCP (@vapi-ai/mcp-server reads VAPI_TOKEN; wrapper maps this key)
VAPI_API_KEY=your-vapi-api-key
# Optional alias for MCP tooling
# VAPI_TOKEN=your-vapi-api-key

# Admin API (x-api-key header) — also protects GET/POST/PUT/DELETE /patients
ADMIN_API_KEY=change-me-admin-key

# Default agent slug used when none is resolved from the call
DEFAULT_AGENT_SLUG=default

# Prompt templates root (relative to cwd)
PROMPTS_DIR=prompts

# Intent catalog JSON (relative to cwd or absolute)
INTENTS_CONFIG=config/intents.json


# Public webhook base (ngrok locally, Railway in prod) — no trailing slash
# PUBLIC_BASE_URL=https://lanky-factsheet-cavity.ngrok-free.dev
# Vapi Server URL = ${PUBLIC_BASE_URL}/webhooks/vapi

# ngrok (local Vapi webhooks) — https://dashboard.ngrok.com/get-started/your-authtoken
# Set ENABLE_NGROK=true, then run: npm run dev:tunnel
ENABLE_NGROK=false
NGROK_AUTHTOKEN=
# Reserved hostname only (no https://)
# NGROK_DOMAIN=lanky-factsheet-cavity.ngrok-free.dev

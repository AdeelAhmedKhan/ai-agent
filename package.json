{
  "name": "voice-ai-agent",
  "version": "1.0.0",
  "description": "Voice AI patient registration agent (Vapi + Express + Supabase)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:tunnel": "tsx watch src/scripts/dev-tunnel.ts",
    "tunnel": "tsx src/scripts/tunnel-only.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/unit/tools/*.test.ts tests/unit/validators/*.test.ts tests/unit/prompts/*.test.ts tests/unit/services/*.test.ts",
    "test:watch": "tsx --watch --test tests/unit/tools/*.test.ts tests/unit/validators/*.test.ts tests/unit/prompts/*.test.ts tests/unit/services/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:migrate:new": "supabase migration new",
    "db:diff": "supabase db diff -f",
    "db:push": "supabase db push",
    "db:pull": "supabase db pull",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "vapi": "node scripts/vapi.mjs",
    "vapi:install": "node scripts/install-vapi-cli.mjs",
    "vapi:login": "node scripts/vapi.mjs login",
    "vapi:whoami": "node scripts/vapi.mjs auth whoami",
    "vapi:listen": "node scripts/vapi.mjs listen --forward-to http://localhost:3000/webhooks/vapi",
    "vapi:mcp": "node scripts/vapi.mjs mcp setup cursor",
    "vapi:mcp:status": "node scripts/vapi.mjs mcp status"
  },
  "keywords": [
    "voice-ai",
    "vapi",
    "express",
    "supabase",
    "groq"
  ],
  "license": "MIT",
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "@supabase/supabase-js": "^2.110.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "openai": "^6.49.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@vapi-ai/mcp-server": "^0.0.9",
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
